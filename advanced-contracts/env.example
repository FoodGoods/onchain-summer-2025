# Advanced Contracts Environment Configuration

# Base Network RPC URLs
BASE_SEPOLIA_RPC_URL="https://sepolia.base.org"
BASE_MAINNET_RPC_URL="https://mainnet.base.org"

# API Keys (get from respective services)
BASESCAN_API_KEY="your_basescan_api_key_here"

# Private key will be stored securely in Foundry keystore
# DO NOT put your private key here!
# Use: cast wallet import deployer --interactive

# Deployment Configuration
DEPLOYMENT_NETWORK="base_sepolia"
VERIFY_CONTRACTS=true

# Contract-specific settings
MULTISIG_REQUIRED_CONFIRMATIONS=2
STAKING_TOKEN_SUPPLY=1000000
NFT_MARKETPLACE_FEE_RATE=250
YIELD_FARMING_MAX_APY=5000
BRIDGE_CONSENSUS_THRESHOLD=66
